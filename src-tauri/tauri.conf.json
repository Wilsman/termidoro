{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TermiDoro",
  "version": "0.1.0",
  "identifier": "com.termidoro.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "TermiDoro",
        "width": 640,
        "height": 320,
        "minWidth": 640,
        "minHeight": 320,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
